{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mimo-academics",
  "version": "1.0.0",
  "identifier": "cl.mimo.academics",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mimo Academics",
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Education",
    "shortDescription": "Panel universitario: malla, calendario, notas y estudio, sin conexion.",
    "longDescription": "Mimo Academics es un panel de semestre universitario que funciona sin conexion: malla de ramos, calendario, notas, estudio y tiempo. Los datos se guardan en tu equipo y no se envian a ningun sitio.",
    "homepage": "https://github.com/billibu-n/mimo-app",
    "license": "MIT",
    "publisher": "Billibu",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/mimo.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/mimo.desktop"
      }
    }
  }
}